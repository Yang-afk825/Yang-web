# ══════════════════════════════════════════════
#  Python
# ══════════════════════════════════════════════
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# ══════════════════════════════════════════════
#  构建产物
#  (dist/ 下的 exe 需要发布到仓库，故只忽略日志)
# ══════════════════════════════════════════════
build/
dist/*.log
*.ico

# ══════════════════════════════════════════════
#  运行 / 调试产物（不再入库）
# ══════════════════════════════════════════════
*.log
*_debug.*
full_response.html
bypass_response.txt
php_logic_test.json
flag.txt
_chrome_profile*/
build_log.txt

# ══════════════════════════════════════════════
#  归档 / 备份 / 临时
# ══════════════════════════════════════════════
_archive_*/
*.bak
*.bak-*
.git-rewrite/
# 一次性调试脚本（正式测试为 tests/test_*.py，__init__.py 需入库）
tests/_test_*.py
tests/_*.txt
